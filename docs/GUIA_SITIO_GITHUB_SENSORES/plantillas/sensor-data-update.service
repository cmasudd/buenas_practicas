[Unit]
Description=Publicar CSV de sensores en GitHub Pages
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=oneshot
User=USUARIO_SERVICIO
Group=GRUPO_SERVICIO
WorkingDirectory=/RUTA/ABSOLUTA/proyecto-sensores-datos
ExecStart=/usr/bin/flock -n /tmp/PROYECTO-sensor-data.lock /RUTA/ABSOLUTA/proyecto-sensores-datos/scripts/update_data.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
